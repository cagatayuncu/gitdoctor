# Bash must stay LF even on Windows checkouts (Git Bash refuses CRLF shebangs).
* text=auto
*.sh text eol=lf
tests/stubs/gh text eol=lf
# Stub replay fixtures are read verbatim by bash string compares — a CRLF
# checkout would leak \r into values like "true"/"false".
tests/fixtures/** text eol=lf
# Hook files have no .sh extension but must land LF wherever they are copied
# (a CRLF shebang breaks on Linux servers).
integrations/hooks/* text eol=lf
# Union-merge the changelog so release/back-merge legs never conflict on it.
CHANGELOG.md merge=union
*.md text
*.json text
*.yml text
*.ps1 text eol=crlf
*.png binary
