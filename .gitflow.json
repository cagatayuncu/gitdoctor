{
  "$schema": "https://raw.githubusercontent.com/cagatayuncu/gitdoctor/main/schema/gitflow.schema.json",
  "version": 1,
  "versionFiles": [
    {
      "path": "scripts/gitflow-doctor.sh",
      "pattern": "DOCTOR_VERSION=\"([^\"]+)\"",
      "replace": "DOCTOR_VERSION=\"{version}\""
    }
  ],
  "changelog": {
    "enabled": true,
    "file": "CHANGELOG.md",
    "convention": "conventional-commits"
  },
  "homebrew": {
    "tap": "cagatayuncu/homebrew-tap",
    "formula": "Formula/gitdoctor.rb"
  }
}
